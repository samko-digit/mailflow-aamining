generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Comptes MailFlow. L'identité vient de l'annuaire du client (fédération) ;
/// `entraObjectId` fait le lien. Aucun mot de passe n'est stocké ici.
model Utilisateur {
  id                  String        @id @default(cuid())
  email               String        @unique
  nomComplet          String        @map("nom_complet")
  /// Repli quand aucune photo n'est disponible
  initiales           String?
  avatarUrl           String?       @map("avatar_url")
  fonction            String?
  role                Role          @default(RESPONSABLE)
  actif               Boolean       @default(true)
  entraObjectId       String?       @unique @map("entra_object_id")
  /// Suppléant par défaut. Reçoit les relances pendant une absence déclarée.
  suppleantId         String?       @map("suppleant_id")
  creeLe              DateTime      @default(now()) @map("cree_le")
  modifieLe           DateTime      @updatedAt @map("modifie_le")
  absences            Absence[]
  categoriesEscalade  Categorie[]   @relation("CategorieEscalade")
  echangesRepondus    Echange[]     @relation("EchangeReponsePar")
  echangesResponsable Echange[]     @relation("EchangeResponsable")
  evenements          Evenement[]   @relation("EvenementAuteur")
  relancesRecues      Relance[]     @relation("RelanceDestinataire")
  suppleant           Utilisateur?  @relation("Suppleance", fields: [suppleantId], references: [id])
  supplees            Utilisateur[] @relation("Suppleance")

  @@index([actif, nomComplet])
  @@map("utilisateur")
}

/// Absences déclarées à la main. Version allégée retenue avec le client :
/// pas de synchronisation avec un logiciel de planning tant qu'il n'en fournit pas.
model Absence {
  id            String      @id @default(cuid())
  utilisateurId String      @map("utilisateur_id")
  debut         DateTime
  fin           DateTime
  motif         String?
  creeLe        DateTime    @default(now()) @map("cree_le")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, debut, fin])
  @@map("absence")
}

/// Interlocuteur externe. Créé automatiquement à la première réception.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Correspondant {
  id           String            @id @default(cuid())
  email        String            @unique
  nom          String?
  organisation String?
  type         TypeCorrespondant @default(AUTRE)
  notes        String?
  actif        Boolean           @default(true)
  creeLe       DateTime          @default(now()) @map("cree_le")
  modifieLe    DateTime          @updatedAt @map("modifie_le")
  echanges     Echange[]

  @@index([organisation])
  @@map("correspondant")
}

/// Une boîte surveillée. Une seule au démarrage, le modèle en prévoit plusieurs.
/// Porte l'état de la synchronisation : c'est ici que vivent le jeton
/// différentiel et l'échéance de l'abonnement aux notifications, dont
/// l'oubli de renouvellement est la panne la plus fréquente de ce type d'outil.
model BoiteSuivie {
  id                 String      @id @default(cuid())
  adresse            String      @unique
  libelle            String
  fournisseur        Fournisseur @default(MICROSOFT)
  actif              Boolean     @default(true)
  abonnementId       String?     @map("abonnement_id")
  abonnementExpireLe DateTime?   @map("abonnement_expire_le")
  jetonDelta         String?     @map("jeton_delta")
  derniereSynchroLe  DateTime?   @map("derniere_synchro_le")
  derniereAnomalie   String?     @map("derniere_anomalie")
  creeLe             DateTime    @default(now()) @map("cree_le")
  modifieLe          DateTime    @updatedAt @map("modifie_le")
  echanges           Echange[]
  messages           Message[]

  @@map("boite_suivie")
}

/// Liste d'exclusion : notifications, plateformes, veille commerciale.
/// C'est le filtre le plus rentable du dispositif compte tenu du bruit
/// qui domine une boîte de correspondance.
model ExpediteurExclu {
  id     String        @id @default(cuid())
  type   TypeExclusion @default(ADRESSE)
  valeur String
  /// Pourquoi il a été exclu, pour pouvoir le retirer plus tard
  motif  String?
  actif  Boolean       @default(true)
  creeLe DateTime      @default(now()) @map("cree_le")

  @@unique([type, valeur])
  @@map("expediteur_exclu")
}

/// Catégorie d'échange. Porte la priorité par défaut et la cible d'escalade.
/// Les délais sont dans RegleRelance, une ligne par relance successive.
model Categorie {
  id             String         @id @default(cuid())
  code           String         @unique
  libelle        String
  /// Liseré de la ligne dans la console
  couleur        String         @default("#3d6675")
  priorite       Priorite       @default(NORMALE)
  ordre          Int            @default(0)
  actif          Boolean        @default(true)
  /// Vrai pour les catégories dont l'échéance est imposée de l'extérieur
  /// (tutelle, douane, fiscalité). Les relances se calculent alors à rebours
  /// depuis `Echange.dateButoir` et non en avant depuis la réception.
  aDateButoir    Boolean        @default(false) @map("a_date_butoir")
  escaladeVersId String?        @map("escalade_vers_id")
  creeLe         DateTime       @default(now()) @map("cree_le")
  modifieLe      DateTime       @updatedAt @map("modifie_le")
  escaladeVers   Utilisateur?   @relation("CategorieEscalade", fields: [escaladeVersId], references: [id])
  echanges       Echange[]
  regles         RegleRelance[]

  @@map("categorie")
}

/// Une ligne par relance successive d'une catégorie. `ordre` = 1 pour la
/// première relance. `delaiJoursOuvres` se compte depuis la réception, ou
/// à rebours depuis la date butoir si la catégorie en porte une.
model RegleRelance {
  id               String              @id @default(cuid())
  categorieId      String              @map("categorie_id")
  ordre            Int
  delaiJoursOuvres Int                 @map("delai_jours_ouvres")
  destinataire     DestinataireRelance @default(PROPRIETAIRE)
  copieA           String[]            @default([]) @map("copie_a")
  modeleId         String?             @map("modele_id")
  actif            Boolean             @default(true)
  creeLe           DateTime            @default(now()) @map("cree_le")
  modifieLe        DateTime            @updatedAt @map("modifie_le")
  categorie        Categorie           @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  modele           ModeleMessage?      @relation(fields: [modeleId], references: [id])

  @@unique([categorieId, ordre])
  @@map("regle_relance")
}

/// Modèles de message. Trois suffisent : rappel courtois, rappel ferme,
/// note d'escalade. Variables au format {{nom}}.
model ModeleMessage {
  id        String         @id @default(cuid())
  code      String         @unique
  libelle   String
  sujet     String
  corps     String
  actif     Boolean        @default(true)
  creeLe    DateTime       @default(now()) @map("cree_le")
  modifieLe DateTime       @updatedAt @map("modifie_le")
  regles    RegleRelance[]
  relances  Relance[]

  @@map("modele_message")
}

/// Jours chômés. Saisis par l'administrateur, jamais codés en dur.
/// Ajouter un jour férié doit déclencher le recalcul des échéances à venir.
model JourFerie {
  id      String   @id @default(cuid())
  date    DateTime @unique @db.Date
  libelle String

  @@map("jour_ferie")
}

/// Paramètres généraux : fuseau du site, fenêtre d'envoi, cadence de synchro,
/// seuils d'alerte. Une seule table clé/valeur plutôt qu'une colonne par réglage.
model Parametre {
  cle       String   @id
  valeur    Json
  libelle   String
  modifieLe DateTime @updatedAt @map("modifie_le")

  @@map("parametre")
}

/// Le dossier de suivi. UNE LIGNE PAR CONVERSATION, jamais par message.
/// C'est la table que la console affiche et que le moteur de relance lit.
model Echange {
  id                 String                   @id @default(cuid())
  /// Référence parlante, citée en réunion
  numero             Int                      @unique @default(autoincrement())
  boiteId            String                   @map("boite_id")
  /// Identifiant de conversation fourni par la messagerie. Unique PAR BOÎTE :
  /// c'est une notion propre à une boîte, elle ne se compare pas d'une boîte
  /// à l'autre. Signal n°1 de la détection des réponses.
  conversationId     String                   @map("conversation_id")
  sujet              String
  /// Aperçu du corps. Le corps intégral n'est jamais stocké ici.
  extrait            String?
  /// Ouverture directe dans Outlook
  webLink            String?                  @map("web_link")
  correspondantId    String                   @map("correspondant_id")
  categorieId        String?                  @map("categorie_id")
  priorite           Priorite                 @default(NORMALE)
  statut             StatutEchange            @default(A_QUALIFIER)
  responsableId      String?                  @map("responsable_id")
  recuLe             DateTime                 @map("recu_le")
  /// Date de réponse attendue, calculée UNE FOIS et écrite. Ne jamais la
  /// recalculer à l'affichage : sinon on ne peut plus expliquer pourquoi
  /// une relance est partie ce jour-là.
  echeance           DateTime?
  /// Date limite imposée de l'extérieur (tutelle, douane, fiscalité).
  /// Ne se décale pas parce que personne ne travaille le week-end.
  dateButoir         DateTime?                @map("date_butoir")
  prochaineRelanceLe DateTime?                @map("prochaine_relance_le")
  derniereRelanceLe  DateTime?                @map("derniere_relance_le")
  /// Compteur dénormalisé, incrémenté DANS LA MÊME TRANSACTION que l'insertion
  /// dans `relance`. La table `relance` reste la vérité ; un contrôle nocturne
  /// compare les deux et signale toute divergence.
  nbRelances         Int                      @default(0) @map("nb_relances")
  reponduLe          DateTime?                @map("repondu_le")
  /// Preuve de ce qui a arrêté les relances
  reponseMessageId   String?                  @map("reponse_message_id")
  reponseParId       String?                  @map("reponse_par_id")
  canalReponse       CanalReponse?            @map("canal_reponse")
  /// Obligatoire pour SANS_SUITE et pour toute clôture manuelle.
  motifCloture       String?                  @map("motif_cloture")
  aPieceJointe       Boolean                  @default(false) @map("a_piece_jointe")
  archiveLe          DateTime?                @map("archive_le")
  archiveUrl         String?                  @map("archive_url")
  creeLe             DateTime                 @default(now()) @map("cree_le")
  modifieLe          DateTime                 @updatedAt @map("modifie_le")
  /// Colonne générée en SQL (voir prisma/sql/02_recherche.sql).
  /// Déclarée ici pour que Prisma ne la supprime pas à la migration suivante.
  recherche          Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('french'::regconfig, COALESCE(sujet, ''::text)), 'A'::\"char\") || setweight(to_tsvector('french'::regconfig, COALESCE(extrait, ''::text)), 'B'::\"char\"))"))
  boite              BoiteSuivie              @relation(fields: [boiteId], references: [id])
  categorie          Categorie?               @relation(fields: [categorieId], references: [id])
  correspondant      Correspondant            @relation(fields: [correspondantId], references: [id])
  reponsePar         Utilisateur?             @relation("EchangeReponsePar", fields: [reponseParId], references: [id])
  responsable        Utilisateur?             @relation("EchangeResponsable", fields: [responsableId], references: [id])
  evenements         Evenement[]
  messages           Message[]
  relances           Relance[]
  travaux            TravailPlanifie[]

  @@unique([boiteId, conversationId])
  @@index([statut, echeance])
  @@index([responsableId, statut])
  @@index([correspondantId, recuLe])
  @@index([prochaineRelanceLe])
  @@index([recuLe])
  @@index([recuLe(sort: Desc)], map: "echange_a_qualifier_idx", where: raw("(statut = 'A_QUALIFIER'::\"StatutEchange\")"))
  @@index([echeance], map: "echange_actif_echeance_idx", where: raw("(statut = ANY (ARRAY['A_QUALIFIER'::\"StatutEchange\", 'EN_ATTENTE'::\"StatutEchange\", 'RELANCE'::\"StatutEchange\", 'ESCALADE'::\"StatutEchange\"]))"))
  @@index([responsableId, echeance], map: "echange_actif_responsable_idx", where: raw("(statut = ANY (ARRAY['EN_ATTENTE'::\"StatutEchange\", 'RELANCE'::\"StatutEchange\", 'ESCALADE'::\"StatutEchange\"]))"))
  @@index([prochaineRelanceLe], map: "echange_prochaine_relance_idx", where: raw("((prochaine_relance_le IS NOT NULL) AND (statut = ANY (ARRAY['EN_ATTENTE'::\"StatutEchange\", 'RELANCE'::\"StatutEchange\"])))"))
  @@index([recuLe], map: "echange_sans_responsable_idx", where: raw("((responsable_id IS NULL) AND (statut = ANY (ARRAY['A_QUALIFIER'::\"StatutEchange\", 'EN_ATTENTE'::\"StatutEchange\"])))"))
  @@map("echange")
}

/// Chaque message du fil, entrant comme sortant. Le sortant sert à prouver
/// qu'une réponse est partie et à identifier son auteur.
model Message {
  id                   String        @id @default(cuid())
  echangeId            String        @map("echange_id")
  boiteId              String        @map("boite_id")
  /// Identifiant normalisé porté par le message lui-même, stable entre
  /// systèmes de messagerie. Contrainte d'unicité : c'est la BASE qui refuse
  /// le doublon, pas une vérification préalable dans le code.
  internetMessageId    String        @unique @map("internet_message_id")
  /// Identifiant propre au fournisseur, pour aller relire le message.
  messageIdFournisseur String?       @map("message_id_fournisseur")
  /// UID IMAP pour aller relire le message brut
  uidImap              Int?          @map("uid_imap")
  inReplyTo            String?       @map("in_reply_to")
  /// Chaîne des parents, signal n°2
  references           String[]      @default([])
  sens                 SensMessage
  expediteur           String
  destinataires        String[]      @default([])
  copie                String[]      @default([])
  sujet                String
  extrait              String?
  dateMessage          DateTime      @map("date_message")
  aPieceJointe         Boolean       @default(false) @map("a_piece_jointe")
  /// Réponse automatique, absence du bureau ou rapport de non-remise.
  /// Ne vaut jamais réponse. Un rapport de non-remise est un INCIDENT :
  /// le courriel n'est pas parti, l'échange repasse en attente avec alerte.
  estAutomatique       Boolean       @default(false) @map("est_automatique")
  estNonRemise         Boolean       @default(false) @map("est_non_remise")
  creeLe               DateTime      @default(now()) @map("cree_le")
  boite                BoiteSuivie   @relation(fields: [boiteId], references: [id])
  echange              Echange       @relation(fields: [echangeId], references: [id], onDelete: Cascade)
  piecesJointes        PieceJointe[]

  @@index([echangeId, dateMessage])
  @@index([boiteId, dateMessage])
  @@map("message")
}

/// Métadonnées des pièces jointes. Le fichier vit dans le stockage objet,
/// jamais en base. Le nom d'origine est conservé tel quel : une pièce
/// renommée est une pièce perdue pour le correspondant qui la redemande.
model PieceJointe {
  id            String    @id @default(cuid())
  messageId     String    @map("message_id")
  nomOrigine    String    @map("nom_origine")
  typeMime      String    @map("type_mime")
  tailleOctets  BigInt    @map("taille_octets")
  /// SHA-256, prouve la non-altération
  empreinte     String?
  /// Vide tant que non téléchargée
  cleStockage   String?   @map("cle_stockage")
  telechargeLe  DateTime? @map("telecharge_le")
  /// Image incorporée dans une signature : ignorée par défaut.
  estIncorporee Boolean   @default(false) @map("est_incorporee")
  creeLe        DateTime  @default(now()) @map("cree_le")
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("piece_jointe")
}

/// Une ligne par relance EFFECTIVEMENT ENVOYÉE. Une relance en échec ne
/// consomme pas de rang et déclenche une alerte.
model Relance {
  id              String         @id @default(cuid())
  echangeId       String         @map("echange_id")
  /// 1 = première relance
  ordre           Int
  destinataireId  String         @map("destinataire_id")
  copieA          String[]       @default([]) @map("copie_a")
  modeleId        String?        @map("modele_id")
  statut          StatutRelance  @default(ENVOYEE)
  envoyeeLe       DateTime       @default(now()) @map("envoyee_le")
  messageIdEnvoye String?        @map("message_id_envoye")
  erreur          String?
  /// Empêche le double envoi si le traitement est rejoué après un incident.
  cleIdempotence  String         @unique @map("cle_idempotence")
  destinataire    Utilisateur    @relation("RelanceDestinataire", fields: [destinataireId], references: [id])
  echange         Echange        @relation(fields: [echangeId], references: [id], onDelete: Cascade)
  modele          ModeleMessage? @relation(fields: [modeleId], references: [id])

  @@unique([echangeId, ordre])
  @@index([envoyeeLe])
  @@index([echangeId, ordre], map: "relance_echange_idx", where: raw("(statut = 'ENVOYEE'::\"StatutRelance\")"))
  @@map("relance")
}

/// File de travaux persistée en base. Une tâche planifiée en mémoire
/// disparaît au redémarrage ; les échéances doivent survivre à un arrêt.
/// Lue par une requête unique avec FOR UPDATE SKIP LOCKED, ce qui permet
/// plusieurs exécutants sans double envoi (voir docs/modele-donnees.md).
model TravailPlanifie {
  id             String        @id @default(cuid())
  type           TypeTravail
  echangeId      String?       @map("echange_id")
  executerA      DateTime      @map("executer_a")
  statut         StatutTravail @default(EN_ATTENTE)
  tentatives     Int           @default(0)
  derniereErreur String?       @map("derniere_erreur")
  /// Identifiant de l'exécutant
  verrouPar      String?       @map("verrou_par")
  verrouA        DateTime?     @map("verrou_a")
  /// Données nécessaires à l'exécution (ordre de relance, cible…)
  charge         Json?
  cleIdempotence String        @unique @map("cle_idempotence")
  creeLe         DateTime      @default(now()) @map("cree_le")
  termineLe      DateTime?     @map("termine_le")
  echange        Echange?      @relation(fields: [echangeId], references: [id], onDelete: Cascade)

  @@index([statut, executerA])
  @@index([echangeId, type])
  @@index([executerA], map: "travail_a_executer_idx", where: raw("(statut = 'EN_ATTENTE'::\"StatutTravail\")"))
  @@index([verrouA], map: "travail_verrou_perime_idx", where: raw("(statut = 'EN_COURS'::\"StatutTravail\")"))
  @@map("travail_planifie")
}

/// Alimente « Activité récente » et « Journal d'activité ». Table en
/// écriture seule : on n'y modifie ni n'y supprime jamais une ligne.
model Evenement {
  id            String        @id @default(cuid())
  type          TypeEvenement
  acteur        Acteur        @default(SYSTEME)
  utilisateurId String?       @map("utilisateur_id")
  echangeId     String?       @map("echange_id")
  libelle       String
  valeurAvant   Json?         @map("valeur_avant")
  valeurApres   Json?         @map("valeur_apres")
  creeLe        DateTime      @default(now()) @map("cree_le")
  echange       Echange?      @relation(fields: [echangeId], references: [id])
  utilisateur   Utilisateur?  @relation("EvenementAuteur", fields: [utilisateurId], references: [id])

  @@index([creeLe])
  @@index([echangeId, creeLe])
  @@index([type, creeLe])
  @@map("evenement")
}

/// Rôles applicatifs. Le rôle est porté par MailFlow, pas par l'annuaire.
enum Role {
  /// Paramétrage, utilisateurs, règles, journal complet
  ADMINISTRATEUR
  /// Qualifie, attribue, clôt, relance manuellement
  GESTIONNAIRE
  /// Voit et traite les échanges dont il est propriétaire
  RESPONSABLE
  /// Consultation et recherche uniquement
  LECTEUR
}

/// États d'un échange. Mutuellement exclusifs : c'est ce qui permet à la
/// répartition affichée sur le tableau de bord de sommer au total.
/// « En retard » n'est PAS un état : c'est `echeance < now()` sur un état actif.
enum StatutEchange {
  /// Capté, engagement non tranché
  A_QUALIFIER
  /// Propriétaire désigné, compte à rebours lancé
  EN_ATTENTE
  /// Au moins une relance envoyée, toujours sans réponse
  RELANCE
  /// Relances épuisées, hiérarchie informée
  ESCALADE
  /// Réponse détectée ou déclarée, relances arrêtées
  REPONDU
  /// Décision explicite de ne pas répondre (motif obligatoire)
  SANS_SUITE
  /// Faux positif, alimente la liste d'exclusion
  HORS_PERIMETRE
  /// Fil et pièces déposés dans le stockage objet
  ARCHIVE
}

/// Sert au liseré de couleur en tête de ligne dans la console.
enum Priorite {
  BASSE
  NORMALE
  HAUTE
  CRITIQUE
}

enum TypeCorrespondant {
  CLIENT
  FOURNISSEUR
  /// Tutelle, douane, administration fiscale : porte souvent une date butoir
  AUTORITE
  PARTENAIRE
  INTERNE
  AUTRE
}

enum SensMessage {
  ENTRANT
  SORTANT
}

/// Canal par lequel la réponse a été obtenue. Un échange peut se clore
/// hors messagerie : le registre doit refléter la réalité, pas seulement Outlook.
enum CanalReponse {
  MAIL
  TELEPHONE
  REUNION
  WHATSAPP
  PHYSIQUE
}

/// Qui reçoit une relance donnée. Résolu à l'envoi, pas à la planification :
/// le suppléant dépend des absences en cours au moment de l'envoi.
enum DestinataireRelance {
  PROPRIETAIRE
  SUPPLEANT
  ESCALADE
}

enum TypeTravail {
  RELANCE
  VERIFICATION_REPONSE
  ESCALADE
  ARCHIVAGE
  SYNCHRO_BOITE
  RENOUVELLEMENT_ABONNEMENT
  TRANSFERT
}

enum StatutTravail {
  EN_ATTENTE
  EN_COURS
  TERMINE
  /// Tentatives épuisées : déclenche une alerte, jamais un nouvel essai silencieux
  ECHEC
  /// Rendu caduc, typiquement par la détection d'une réponse
  ANNULE
}

enum StatutRelance {
  ENVOYEE
  ECHEC
}

/// Alimente « Activité récente » et « Journal d'activité ».
enum TypeEvenement {
  MAIL_DETECTE
  MAIL_ENREGISTRE
  MAIL_QUALIFIE
  MAIL_ATTRIBUE
  MAIL_TRANSMIS
  RELANCE_ENVOYEE
  RELANCE_REPORTEE
  RELANCE_ECHEC
  REPONSE_DETECTEE
  REPONSE_DECLAREE
  ESCALADE_DECLENCHEE
  ECHANGE_CLOS
  MAIL_ARCHIVE
  PARAMETRE_MODIFIE
  REGLE_MODIFIEE
  UTILISATEUR_MODIFIE
  ANOMALIE_TECHNIQUE
  MAIL_REQUALIFIE
}

enum Acteur {
  SYSTEME
  UTILISATEUR
}

enum TypeExclusion {
  /// Correspondance exacte
  ADRESSE
  /// Tout un domaine expéditeur
  DOMAINE
  /// Expression régulière sur l'adresse ou l'objet
  MOTIF
}

enum Fournisseur {
  MICROSOFT
  GOOGLE
  IMAP
}
