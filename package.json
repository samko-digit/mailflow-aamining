{
  "name": "mailflow",
  "version": "0.1.0",
  "private": true,
  "description": "MailFlow · Suivi, relance et archivage des courriels engageants",
  "type": "module",
  "scripts": {
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "node --import tsx scripts/verifier-socle.ts",
    "test": "node --import tsx --test tests/echeance.test.ts tests/cycle-echange.test.ts tests/decision.test.ts tests/normalisation.test.ts tests/envoi.test.ts tests/composition.test.ts tests/alerte.test.ts tests/corriger-travaux-retard.test.ts tests/transfert.test.ts tests/chirurgie-mime.test.ts",
    "typecheck": "tsc --noEmit",
    "db:demo": "node --import tsx prisma/seed-demo.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "moteur": "node --import tsx scripts/moteur.ts",
    "moteur:boucle": "node --import tsx scripts/moteur.ts --boucle",
    "moteur:sante": "node --import tsx scripts/moteur.ts --sante",
    "graph:test": "node --import tsx scripts/verifier-graph.ts",
    "n8n:audit": "node --import tsx scripts/auditer-n8n.ts",
    "imap:test": "node --import tsx scripts/verifier-imap.ts",
    "capter": "node --import tsx scripts/capter.ts",
    "envoi:essai": "node --import tsx scripts/essai-envoi.ts",
    "moteur:essai": "node --import tsx scripts/essai-moteur.ts",
    "n8n:deployer": "node --import tsx scripts/deployer-transfert-n8n.ts",
    "n8n:tester": "node --import tsx scripts/tester-transfert-n8n.ts",
    "n8n:tester-callback": "node --import tsx scripts/tester-callback-mailflow.ts",
    "transfert:essai": "node --import tsx scripts/essai-transfert-bout-en-bout.ts",
    "transfert:reponse": "node --import tsx scripts/essai-transfert-bout-en-bout.ts --reponse",
    "extraits:verifier": "node --import tsx scripts/reparer-extraits.ts",
    "extraits:reparer": "node --import tsx scripts/reparer-extraits.ts --reparer",
    "demo:inventaire": "node --import tsx scripts/purger-demonstration.ts",
    "demo:purger": "node --import tsx scripts/purger-demonstration.ts --purger",
    "utilisateurs:inventaire": "node --import tsx scripts/creer-utilisateurs-reels.ts",
    "utilisateurs:creer": "node --import tsx scripts/creer-utilisateurs-reels.ts --creer",
    "db:sauvegarder": "node --import tsx scripts/sauvegarder-base.ts",
    "base:inventaire": "node --import tsx scripts/repartir-a-zero.ts",
    "base:remise-a-zero": "node --import tsx scripts/repartir-a-zero.ts --executer"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.5",
    "imapflow": "^2.0.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.23",
    "next": "^16.3.4",
    "nodemailer": "^10.0.1",
    "pg": "^8.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
