# Base de données MailFlow
DATABASE_URL="postgresql://mailflow:motdepasse@localhost:5432/mailflow?schema=public"

# Base d'ombre utilisée par Migrate (facultative en local)
# SHADOW_DATABASE_URL="postgresql://mailflow:motdepasse@localhost:5432/mailflow_shadow?schema=public"

# Taille de la réserve de connexions (voir src/lib/prisma.ts)
DATABASE_POOL_MAX=10

# ── Accès Microsoft 365 (voir docs/acces-microsoft.md) ────────────────────
# Portail Entra → votre application → Vue d'ensemble
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# Certificats et secrets → colonne « Valeur », visible une seule fois
AZURE_CLIENT_SECRET=""
# Date d'expiration du secret, pour l'alerte à 30 jours (AAAA-MM-JJ)
AZURE_CLIENT_SECRET_EXPIRE="2028-09-07"

# La boîte réellement suivie
MAILFLOW_BOITE="administration@exemple.com"
# Une boîte de test, distincte, sinon les essais partent à de vrais clients
MAILFLOW_BOITE_RECETTE="recette-mailflow@exemple.com"

# ── Boîte suivie, en IMAP et SMTP (voir docs/essais-messagerie.md) ────────
# Réglages Hostinger. Vérifier dans le panneau : Emails → Comptes → Paramètres
MAILFLOW_IMAP_HOTE="imap.hostinger.com"
MAILFLOW_IMAP_PORT="993"
MAILFLOW_IMAP_UTILISATEUR="dec@samko.group"     # presque toujours l'adresse complète
MAILFLOW_IMAP_MOT_DE_PASSE="REMPLACER-PAR-LE-VRAI-MOT-DE-PASSE"

MAILFLOW_SMTP_HOTE="smtp.hostinger.com"
MAILFLOW_SMTP_PORT="465"

# L'adresse affichée de la boîte suivie
MAILFLOW_BOITE="dec@samko.group"
# Laisser vide : le script détecte le dossier des envoyés et vous donne la valeur
MAILFLOW_DOSSIER_ENVOYES=""

# ── Garde-fous d'essai ────────────────────────────────────────────────────
# Tant que ceci vaut false, AUCUN message ne peut partir, quoi qu'il arrive
MAILFLOW_ENVOI_AUTORISE="false"
# Liste blanche : même envoi autorisé, seules ces adresses peuvent recevoir
MAILFLOW_DESTINATAIRES_AUTORISES="dec@samko.group"

# Domaines de la maison, séparés par des virgules
MAILFLOW_DOMAINES_INTERNES="exemple.com"

# ── Moteur ────────────────────────────────────────────────────────────────
# Nom affiché comme expéditeur des relances
MAILFLOW_NOM_EXPEDITEUR="Suivi du courrier"
# Adresse de la console, citée dans les modèles de relance ({{lienFiche}}).
# Sans elle, les liens des messages pointent sur localhost.
MAILFLOW_URL_CONSOLE="http://localhost:3000"
# Intervalle entre deux lectures de la boîte, en minutes
MAILFLOW_CADENCE_CAPTATION_MINUTES="5"

# ── Canal d'alerte ────────────────────────────────────────────────────────
# Qui reçoit un courriel quand quelque chose est CASSÉ : anomalie critique,
# relance non remise, dossier rouvert. Ce qui demande seulement de l'attention
# reste dans la console. Une même alarme n'est pas répétée avant 4 heures.
#
# Vide = les alarmes restent en base et à l'écran, personne n'est prévenu.
# Ces adresses doivent aussi figurer dans MAILFLOW_DESTINATAIRES_AUTORISES.
MAILFLOW_ALERTES_A=""

# ── Transfert automatique via n8n (voir src/moteur/ordonnanceur.ts) ───────
# Sans ces quatre variables, executerTransfert() sort en « périmé » avant
# tout appel : aucun transfert ne peut avoir lieu.
#
# URL du webhook n8n qui reçoit la demande de transfert.
N8N_WEBHOOK_URL=""
# Secret partagé, utilisé DANS LES DEUX SENS :
#   MailFlow → n8n  : X-MailFlow-Signature = HMAC-SHA256(secret, `${ts}.${body}`)
#   n8n → MailFlow  : mêmes en-têtes, sur /api/transfer-callback
# Doit être identique des deux côtés. Ne jamais le journaliser.
N8N_WEBHOOK_SECRET=""
# Liste blanche des destinations de transfert autorisées, séparées par des
# virgules. Une destination absente de cette liste fait périmer le travail.
MAILFLOW_DESTINATIONS_TRANSFERT=""
# Délai au-delà duquel un TRANSFERT resté EN_COURS sans callback est annulé.
MAILFLOW_TRANSFERT_TIMEOUT_MINUTES="30"

# ── Audit de l'instance n8n (scripts/auditer-n8n.ts) ──────────────────────
# Lecture seule. Settings → n8n API → Create an API key.
N8N_BASE_URL=""
N8N_API_KEY=""
